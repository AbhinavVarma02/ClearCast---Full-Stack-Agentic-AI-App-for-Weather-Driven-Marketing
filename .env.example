# ClearCast Environment Variables
# Copy this file to .env and fill in your actual keys. Never commit .env.

# OpenWeatherMap API (free tier: https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# OpenAI API (for GPT-4o-mini)
OPENAI_API_KEY=your_openai_key_here

# LangSmith (optional, for tracing: https://smith.langchain.com)
# Tracing is enabled only when this is true AND an API key is set.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clearcast

# Optional: estimate model cost only if you set current per-token prices (USD per 1M tokens).
# CLEARCAST_MODEL_INPUT_USD_PER_1M_TOKENS=
# CLEARCAST_MODEL_OUTPUT_USD_PER_1M_TOKENS=

# Optional: offline demo/test mode with synthetic weather (never set in production).
# CLEARCAST_WEATHER_FIXTURES=baseline_mild
