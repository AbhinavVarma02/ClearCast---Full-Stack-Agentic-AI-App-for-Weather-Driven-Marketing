    "CitedValue": {
      "additionalProperties": false,
      "description": "The model restates the values it relied on for one cited block; Python checks each one.",
      "properties": {
        "aqi": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "That block's AQI (1-5) copied from its row, or null if the row shows n/a.",
          "title": "Aqi"
        },
        "observation_id": {
          "description": "ID of one forecast block cited by this window.",
          "title": "Observation Id",
          "type": "string"
        },
        "precipitation_probability_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "That block's precipitation probability in PERCENT (0-100), copied from its row.",
          "title": "Precipitation Probability Pct"
        },
        "temperature_f": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "That block's temperature in °F, copied from its row.",
          "title": "Temperature F"
        },
        "wind_speed_mph": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "That block's wind speed in mph, copied from its row.",
          "title": "Wind Speed Mph"
        }
      },
      "required": [
        "observation_id",
        "temperature_f",
        "precipitation_probability_pct",
        "wind_speed_mph",
        "aqi"
      ],
      "title": "CitedValue",
      "type": "object"
    },
    "ClaimedConditions": {
      "additionalProperties": false,
      "properties": {
        "cited_values": {
          "description": "Exactly one entry per cited forecast block, with values copied from the evidence table.",
          "items": {
            "$ref": "#/$defs/CitedValue"
          },
          "title": "Cited Values",
          "type": "array"
        },
        "conditions_summary": {
          "description": "Short description of the cited conditions.",
          "title": "Conditions Summary",
          "type": "string"
        }
      },
      "required": [
        "cited_values",
        "conditions_summary"
      ],
      "title": "ClaimedConditions",
      "type": "object"
    },
    "ClientConstraints": {
      "additionalProperties": false,
      "description": "Hard constraints verified by deterministic Python rules, never by the model.",
      "properties": {
        "allowed_hours": {
          "items": {
            "$ref": "#/$defs/HourRange"
          },
          "maxItems": 6,
          "title": "Allowed Hours",
          "type": "array"
        },
        "exclusion_windows": {
          "items": {
            "$ref": "#/$defs/ExclusionWindow"
          },
          "maxItems": 14,
          "title": "Exclusion Windows",
          "type": "array"
        },
        "max_aqi": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Aqi"
        },
        "max_precipitation_probability_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Precipitation Probability Pct"
        },
        "max_temperature_f": {
          "anyOf": [
            {
              "maximum": 140,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Temperature F"
        },
        "max_wind_speed_mph": {
          "anyOf": [
            {
              "maximum": 150,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wind Speed Mph"
        },
        "min_temperature_f": {
          "anyOf": [
            {
              "maximum": 140,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Temperature F"
        }
      },
      "title": "ClientConstraints",
      "type": "object"
    },
    "ClientPreferences": {
      "additionalProperties": false,
