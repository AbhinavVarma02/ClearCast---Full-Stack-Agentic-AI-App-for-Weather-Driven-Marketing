    "AirQualityObservation": {
      "additionalProperties": false,
      "properties": {
        "aqi": {
          "title": "Aqi",
          "type": "integer"
        },
        "forecast_available": {
          "title": "Forecast Available",
          "type": "boolean"
        },
        "forecast_block_count": {
          "title": "Forecast Block Count",
          "type": "integer"
        },
        "o3_ugm3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "O3 Ugm3"
        },
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at_utc": {
          "format": "date-time",
          "title": "Observed At Utc",
          "type": "string"
        },
        "pm10_ugm3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pm10 Ugm3"
        },
        "pm2_5_ugm3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pm2 5 Ugm3"
        }
      },
      "required": [
        "observation_id",
        "observed_at_utc",
        "aqi",
        "pm2_5_ugm3",
        "pm10_ugm3",
        "o3_ugm3",
        "forecast_available",
        "forecast_block_count"
      ],
      "title": "AirQualityObservation",
      "type": "object"
    },
    "CampaignBrief": {
      "additionalProperties": false,
      "description": "The four original campaign inputs.",
      "properties": {
        "business_type": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f][^\\x00-\\x1f\\x7f]*$",
          "title": "Business Type",
          "type": "string"
        },
        "campaign_goal": {
          "default": "",
          "maxLength": 300,
          "pattern": "^[^\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]*$",
          "title": "Campaign Goal",
          "type": "string"
        },
        "location": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]*[^\\x00-\\x20\\x7f][^\\x00-\\x1f\\x7f]*$",
          "title": "Location",
          "type": "string"
        },
        "tone": {
          "default": "Friendly",
          "enum": [
            "Friendly",
            "Urgent",
            "Playful",
            "Premium"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "location",
        "business_type"
      ],
      "title": "CampaignBrief",
      "type": "object"
    },
