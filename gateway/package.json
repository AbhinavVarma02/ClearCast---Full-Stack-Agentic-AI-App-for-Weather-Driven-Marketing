{
  "name": "clearcast-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "ClearCast Node.js + TypeScript + Fastify integration gateway in front of the Python orchestration service.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
